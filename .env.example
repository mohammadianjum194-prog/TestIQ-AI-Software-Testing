# =============================================================
# TestIQ – .env.example
# Copy this file to .env and fill in your values.
# The application works WITHOUT any API key (rule-based mode).
# =============================================================

# ------------------------------------------------------------
# AI Provider (optional)
# Set to "openai" or "gemini". Leave blank to use rule-based.
# ------------------------------------------------------------
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# AI model to use (only if AI_PROVIDER is set)
AI_MODEL=gpt-3.5-turbo

# ------------------------------------------------------------
# Validation thresholds (optional overrides)
# ------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
NAME_MIN_LENGTH=2
NAME_MAX_LENGTH=100
EMAIL_MAX_LENGTH=254
